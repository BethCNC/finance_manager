{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": "create-react-app",
  "crons": [
    {
      "path": "/api/plaid-sync-cron",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/plaid-sync-cron.js": {
      "maxDuration": 60
    }
  }
}